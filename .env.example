# Copy this file to .env.local (git ignores it) and fill in your Supabase project.
# Supabase dashboard → Project Settings → API (or Data API):
#   Project URL          → VITE_SUPABASE_URL
#   anon / publishable key → VITE_SUPABASE_ANON_KEY
# The anon key is public by design and protected by Row Level Security.
# Never put the service_role (secret) key here: everything in VITE_* ends up in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
